# ---------- Banco de CONTROLE (plataforma/SaaS) ----------
# Um único banco, seu (Fernanda). Guarda as empresas (petshops-clientes), logins e convites.
CONTROL_DATABASE_URL="postgresql://user:password@host:5432/petshop_saas_control?sslmode=require"

# ---------- Banco de um TENANT (uso local/dev, template para prisma/tenant) ----------
# Em produção, cada empresa tem sua própria DATABASE_URL, guardada (criptografada)
# na tabela Empresa do banco de controle — não é uma env var global.
DATABASE_URL="postgresql://user:password@host:5432/petshop_tenant_dev?sslmode=require"

# Chave para criptografar segredos guardados no banco de controle (connection strings
# de cada empresa, tokens de Mercado Pago/WhatsApp de cada empresa).
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-com: openssl rand -base64 32"

# ---------- Provisionamento automático de bancos (Supabase Management API) ----------
# Personal Access Token da sua conta Supabase (Account > Access Tokens).
# PODER AMPLO: cria/apaga projetos na sua organização. Nunca exponha no navegador.
SUPABASE_ACCESS_TOKEN=""
# Slug da sua organização Supabase (aparece na URL do dashboard: supabase.com/dashboard/org/<slug>)
SUPABASE_ORGANIZATION_SLUG=""

# ---------- Envio de e-mail de convite (Resend) ----------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@seudominio.com"

# ---------- Mercado Pago / WhatsApp (uso local/dev apenas) ----------
# Em produção, cada empresa configura as próprias credenciais na tela de
# Configurações (guardadas no banco de controle). Estas env vars só servem
# para você testar localmente antes do multi-tenant estar 100% ligado.
MERCADOPAGO_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""

# URL pública da aplicação (usada em links de pagamento/webhooks/convites)
APP_URL="http://localhost:3000"
