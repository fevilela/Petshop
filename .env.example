# ---------- Banco de dados ----------
# Banco ÚNICO, compartilhado por todos os petshops-clientes (isolamento por
# empresaId em nível de aplicação — ver README, seção "Arquitetura").
DATABASE_URL="postgresql://user:password@host:5432/petshop_saas?sslmode=require"

# Chave para criptografar segredos guardados no banco (token de Mercado Pago
# de cada empresa). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere do mesmo jeito que a ENCRYPTION_KEY"

# ---------- Envio de e-mail de convite (Resend) ----------
# Usado para mandar o link de "criar senha" quando você cadastra um petshop-
# cliente ou um usuário novo em /admin.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@seudominio.com"

# ---------- Seed inicial (seu próprio login de SUPER_ADMIN) ----------
SUPER_ADMIN_EMAIL="fernandavsac@gmail.com"
SUPER_ADMIN_SENHA="defina-uma-senha-forte-aqui"

# ---------- Mercado Pago (uso local/dev apenas) ----------
# Em produção, cada petshop-cliente configura o PRÓPRIO token na tela
# /configuracoes (guardado criptografado no banco, por empresa). Esta env var
# não é lida em nenhum lugar do código — fica só como lembrete.
# MERCADOPAGO_ACCESS_TOKEN=""
#
# WhatsApp não usa credencial nenhuma: o envio de cobrança é por link direto
# (wa.me) — ver README, seção "Mercado Pago e WhatsApp".

# URL pública da aplicação (usada em links de pagamento/webhooks/convites)
APP_URL="http://localhost:3000"

# ---------- Não usado no momento ----------
# Provisionamento automático de um banco Supabase por empresa foi adiado (ver
# src/lib/supabase-management.ts) — hoje todas as empresas compartilham o
# mesmo DATABASE_URL acima. Deixe em branco.
# SUPABASE_ACCESS_TOKEN=""
# SUPABASE_ORGANIZATION_SLUG=""
