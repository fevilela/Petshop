// Schema ÚNICO, compartilhado por TODOS os petshops-clientes da plataforma
// ("banco único, separando por empresaId" — decisão de simplificar o MVP:
// ver comentário no model Empresa e no README para o trade-off completo).
//
// Isolamento entre empresas é feito em nível de aplicação: todo model que
// pertence a um petshop-cliente tem uma coluna `empresaId`, e todo acesso ao
// Prisma Client passa por um Client Extension (ver src/lib/tenant-prisma.ts)
// que injeta esse filtro automaticamente em toda query — nenhuma tela ou
// Server Action precisa (ou pode) esquecer o filtro manualmente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum StatusEmpresa {
  ATIVA
  SUSPENSA
}

enum RoleUsuario {
  SUPER_ADMIN
  EMPRESA_ADMIN
  EMPRESA_ATENDENTE
}

enum TipoDocumento {
  CPF
  CNPJ
}

enum PorteAnimal {
  PEQUENO
  MEDIO
  GRANDE
}

enum StatusCanil {
  LIVRE
  OCUPADO
  MANUTENCAO
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum TipoItemVenda {
  PRODUTO
  SERVICO
}

enum FormaPagamento {
  DINHEIRO
  PIX_MANUAL
  CARTAO_MANUAL
  BOLETO
  PIX_MERCADOPAGO
  CARTAO_LINK
  MENSALISTA
}

enum StatusVenda {
  CONCLUIDA
  CANCELADA
}

enum StatusAssinatura {
  ATIVA
  PAUSADA
  CANCELADA
}

enum TipoCobranca {
  BOLETO
  PIX
  CARTAO_LINK
}

enum StatusCobranca {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

enum StatusConta {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

// ---------- Plataforma (dados da própria SaaS, não de um petshop) ----------

// Um petshop-cliente que assina o SaaS. Cada Empresa usa o MESMO banco que
// todas as outras (isolamento por `empresaId`, não por banco físico) e tem
// suas próprias credenciais de Mercado Pago — nunca compartilhadas entre
// empresas. Envio de cobrança por WhatsApp é feito via link direto (wa.me),
// que não depende de nenhuma credencial própria da empresa (ver README).
model Empresa {
  id                        String        @id @default(cuid())
  nome                      String
  tipoDocumento             TipoDocumento?
  documento                 String?       // CPF ou CNPJ do petshop-cliente, conforme tipoDocumento
  emailResponsavel          String
  status                    StatusEmpresa @default(ATIVA)

  // Credencial própria do petshop (cobrança via Mercado Pago)
  mercadoPagoAccessTokenEnc String?

  // Módulos habilitados para esta empresa (liga/desliga telas inteiras, ex:
  // um petshop sem hotelzinho não precisa de Canil/Hospedagem). Controla o
  // teto de acesso: um usuário nunca vê um módulo que a própria empresa não
  // tem habilitado, mesmo que o campo dele (Usuario.modulosPermitidos) o
  // liste. Ver src/lib/modulos.ts para a lista canônica de chaves válidas.
  modulosHabilitados        String[]      @default(["animais", "canil", "produtos_servicos", "planos", "agenda", "vendas", "financeiro"])

  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  usuarios                  Usuario[]
  convites                  ConviteUsuario[]

  @@index([status])
}

// Login da plataforma. SUPER_ADMIN (a Fernanda) não pertence a nenhuma Empresa
// (empresaId nulo); EMPRESA_ADMIN/EMPRESA_ATENDENTE pertencem a uma Empresa.
model Usuario {
  id                String      @id @default(cuid())
  nome              String
  email             String      @unique
  senhaHash         String?     // nulo até o convite ser aceito e a senha definida
  role              RoleUsuario
  empresaId         String?
  empresa           Empresa?    @relation(fields: [empresaId], references: [id])
  ativo             Boolean     @default(true)
  createdAt         DateTime    @default(now())

  // Só tem efeito para EMPRESA_ATENDENTE (EMPRESA_ADMIN e SUPER_ADMIN sempre
  // veem tudo que a empresa habilitou). Lista vazia = sem restrição extra
  // (herda todos os módulos da empresa); lista não-vazia = restringe à
  // interseção com os módulos da empresa. Ver src/lib/modulos.ts.
  modulosPermitidos String[]    @default([])

  convites          ConviteUsuario[]
  vendasCriadas     Venda[]     @relation("VendaCriadoPor")

  @@index([empresaId])
}

// Token de convite para o usuário definir a própria senha pela primeira vez.
model ConviteUsuario {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId String?
  empresa   Empresa?  @relation(fields: [empresaId], references: [id])
  token     String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

// ---------- Dados operacionais de cada petshop (escopados por empresaId) ----------

model Cliente {
  id            String   @id @default(cuid())
  empresaId     String
  nome          String
  documento     String?  // CPF ou CNPJ
  telefone      String   // WhatsApp, formato E.164 ex: 5511999998888
  email         String?
  endereco      String?
  observacoes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  animais       Animal[]
  vendas        Venda[]
  assinaturas   Assinatura[]
  agendamentos  Agendamento[]
  contasReceber ContaReceber[]

  @@index([empresaId])
  @@index([empresaId, nome])
  @@index([empresaId, telefone])
}

model Animal {
  id             String       @id @default(cuid())
  empresaId      String
  nome           String
  clienteId      String
  cliente        Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  especie        String       // Cão, Gato, etc.
  raca           String?
  porte          PorteAnimal?
  dataNascimento DateTime?
  pesoKg         Decimal?     @db.Decimal(6, 2)
  observacoes    String?      // alergias, restrições, temperamento
  ativo          Boolean      @default(true)
  createdAt      DateTime     @default(now())

  agendamentos   Agendamento[]
  itensVenda     ItemVenda[]
  hospedagens    Hospedagem[]
  vendas         Venda[]

  @@index([empresaId])
  @@index([clienteId])
}

model Canil {
  id             String       @id @default(cuid())
  empresaId      String
  identificador  String       // ex: "Canil 01" — único DENTRO da empresa (duas empresas podem ter as duas um "Canil 01")
  tipoPorte      PorteAnimal?
  capacidade     Int          @default(1)
  status         StatusCanil  @default(LIVRE)
  observacoes    String?

  hospedagens    Hospedagem[]
  agendamentos   Agendamento[]

  @@unique([empresaId, identificador])
  @@index([empresaId])
}

model Hospedagem {
  id               String    @id @default(cuid())
  empresaId        String
  canilId          String
  canil            Canil     @relation(fields: [canilId], references: [id])
  animalId         String
  animal           Animal    @relation(fields: [animalId], references: [id])
  checkIn          DateTime
  checkOutPrevisto DateTime?
  checkOut         DateTime?
  valorDiaria      Decimal?  @db.Decimal(10, 2)
  observacoes      String?
  createdAt        DateTime  @default(now())

  @@index([empresaId])
  @@index([canilId])
  @@index([animalId])
}

model Produto {
  id         String      @id @default(cuid())
  empresaId  String
  nome       String
  categoria  String?
  descricao  String?
  preco      Decimal     @db.Decimal(10, 2)
  estoque    Int         @default(0)
  sku        String?     // único DENTRO da empresa
  ativo      Boolean     @default(true)
  createdAt  DateTime    @default(now())

  itensVenda ItemVenda[]
  planoItens PlanoItem[]

  @@unique([empresaId, sku])
  @@index([empresaId])
}

model Servico {
  id             String        @id @default(cuid())
  empresaId      String
  nome           String
  categoria      String?       // Banho, Tosa, Consulta, Hospedagem/diária...
  descricao      String?
  preco          Decimal       @db.Decimal(10, 2)
  duracaoMinutos Int?
  ativo          Boolean       @default(true)
  createdAt      DateTime      @default(now())

  itensVenda     ItemVenda[]
  planoItens     PlanoItem[]
  agendamentos   Agendamento[]

  @@index([empresaId])
}

// Modelo (template) de plano mensal reutilizável, ex: "Banho Mensal 4x"
model Plano {
  id                String       @id @default(cuid())
  empresaId         String
  nome              String
  descricao         String?
  valorMensal       Decimal      @db.Decimal(10, 2)
  diaCobrancaPadrao Int          @default(5)
  ativo             Boolean      @default(true)
  createdAt         DateTime     @default(now())

  itens             PlanoItem[]
  assinaturas       Assinatura[]

  @@index([empresaId])
}

// Itens inclusos em um plano (quantidade mensal de cada produto/serviço).
// Tem empresaId próprio (mesmo sendo sempre acessado a partir de um Plano)
// porque também é criado/removido de forma avulsa (addPlanoItem/removePlanoItem).
model PlanoItem {
  id         String   @id @default(cuid())
  empresaId  String
  planoId    String
  plano      Plano    @relation(fields: [planoId], references: [id], onDelete: Cascade)
  produtoId  String?
  produto    Produto? @relation(fields: [produtoId], references: [id])
  servicoId  String?
  servico    Servico? @relation(fields: [servicoId], references: [id])
  quantidade Int      @default(1) // quantas vezes por mês está incluso

  @@index([empresaId])
  @@index([planoId])
}

// Assinatura de um cliente a um plano (o que torna o cliente "mensalista")
model Assinatura {
  id            String           @id @default(cuid())
  empresaId     String
  clienteId     String
  cliente       Cliente          @relation(fields: [clienteId], references: [id])
  planoId       String
  plano         Plano            @relation(fields: [planoId], references: [id])
  valorMensal   Decimal          @db.Decimal(10, 2) // copiado do plano na criação, pode ser customizado
  diaCobranca   Int
  status        StatusAssinatura @default(ATIVA)
  dataInicio    DateTime         @default(now())
  dataFim       DateTime?
  createdAt     DateTime         @default(now())

  cobrancas     Cobranca[]
  vendas        Venda[]

  @@index([empresaId])
  @@index([clienteId])
  @@index([status])
}

model Venda {
  id              String         @id @default(cuid())
  empresaId       String
  numero          Int            @unique @default(autoincrement()) // sequência GLOBAL (não por empresa) — ver nota no README
  clienteId       String
  cliente         Cliente        @relation(fields: [clienteId], references: [id])
  animalId        String?
  animal          Animal?        @relation(fields: [animalId], references: [id])
  assinaturaId    String?        // preenchido quando debitado de uma mensalidade
  assinatura      Assinatura?    @relation(fields: [assinaturaId], references: [id])
  formaPagamento  FormaPagamento
  valorTotal      Decimal        @db.Decimal(10, 2)
  status          StatusVenda    @default(CONCLUIDA)
  observacoes     String?
  criadoPorId     String?
  criadoPor       Usuario?       @relation("VendaCriadoPor", fields: [criadoPorId], references: [id])
  createdAt       DateTime       @default(now())

  itens           ItemVenda[]
  cobranca        Cobranca?

  @@index([empresaId])
  @@index([clienteId])
  @@index([createdAt])
}

// Linha de item de uma Venda. NÃO tem empresaId próprio: só existe aninhada
// dentro de uma Venda (nunca é lida/criada/apagada de forma avulsa), então o
// isolamento por empresa vem do join com Venda.empresaId.
model ItemVenda {
  id            String        @id @default(cuid())
  vendaId       String
  venda         Venda         @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  tipo          TipoItemVenda
  produtoId     String?
  produto       Produto?      @relation(fields: [produtoId], references: [id])
  servicoId     String?
  servico       Servico?      @relation(fields: [servicoId], references: [id])
  animalId      String?       // qual animal recebeu o serviço, se aplicável
  animal        Animal?       @relation(fields: [animalId], references: [id])
  quantidade    Int           @default(1)
  precoUnitario Decimal       @db.Decimal(10, 2)
  subtotal      Decimal       @db.Decimal(10, 2)

  @@index([vendaId])
}

// Cobrança gerada via Mercado Pago (boleto / pix / link de cartão),
// vinculada a uma Venda avulsa OU a uma mensalidade de Assinatura.
model Cobranca {
  id               String         @id @default(cuid())
  empresaId        String
  tipo             TipoCobranca
  status           StatusCobranca @default(PENDENTE)
  valor            Decimal        @db.Decimal(10, 2)
  vendaId          String?        @unique
  venda            Venda?         @relation(fields: [vendaId], references: [id])
  assinaturaId     String?
  assinatura       Assinatura?    @relation(fields: [assinaturaId], references: [id])
  referenciaMes    String?        // ex: "2026-08", usado para mensalidades
  mercadoPagoId    String?
  linkPagamento    String?
  qrCode           String?        // payload "copia e cola" do Pix
  qrCodeBase64     String?
  linhaDigitavel   String?        // boleto
  dataVencimento   DateTime
  dataPagamento    DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([empresaId])
  @@index([status])
  @@index([assinaturaId])
}

model ContaPagar {
  id             String      @id @default(cuid())
  empresaId      String
  descricao      String
  fornecedor     String?
  categoria      String?
  valor          Decimal     @db.Decimal(10, 2)
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         StatusConta @default(PENDENTE)
  observacoes    String?
  createdAt      DateTime    @default(now())

  @@index([empresaId])
  @@index([status])
  @@index([dataVencimento])
}

// Recebíveis fora do fluxo padrão de Venda/Cobrança (ex: acordo avulso, reembolso).
// Cobranças de vendas/mensalidades já aparecem no financeiro através do modelo Cobranca.
model ContaReceber {
  id              String      @id @default(cuid())
  empresaId       String
  descricao       String
  clienteId       String?
  cliente         Cliente?    @relation(fields: [clienteId], references: [id])
  valor           Decimal     @db.Decimal(10, 2)
  dataVencimento  DateTime
  dataRecebimento DateTime?
  status          StatusConta @default(PENDENTE)
  observacoes     String?
  createdAt       DateTime    @default(now())

  @@index([empresaId])
  @@index([status])
  @@index([dataVencimento])
}

model Agendamento {
  id             String            @id @default(cuid())
  empresaId      String
  clienteId      String
  cliente        Cliente           @relation(fields: [clienteId], references: [id])
  animalId       String
  animal         Animal            @relation(fields: [animalId], references: [id])
  servicoId      String?
  servico        Servico?          @relation(fields: [servicoId], references: [id])
  canilId        String?
  canil          Canil?            @relation(fields: [canilId], references: [id])
  dataHoraInicio DateTime
  dataHoraFim    DateTime?
  status         StatusAgendamento @default(AGENDADO)
  observacoes    String?
  createdAt      DateTime          @default(now())

  @@index([empresaId])
  @@index([dataHoraInicio])
  @@index([status])
}
