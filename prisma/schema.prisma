// Schema ÚNICO, compartilhado por TODOS os petshops-clientes da plataforma
// ("banco único, separando por empresaId" — decisão de simplificar o MVP:
// ver comentário no model Empresa e no README para o trade-off completo).
//
// Isolamento entre empresas é feito em nível de aplicação: todo model que
// pertence a um petshop-cliente tem uma coluna `empresaId`, e todo acesso ao
// Prisma Client passa por um Client Extension (ver src/lib/tenant-prisma.ts)
// que injeta esse filtro automaticamente em toda query — nenhuma tela ou
// Server Action precisa (ou pode) esquecer o filtro manualmente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum StatusEmpresa {
  ATIVA
  SUSPENSA
}

enum RoleUsuario {
  SUPER_ADMIN
  EMPRESA_ADMIN
  EMPRESA_ATENDENTE
}

enum TipoDocumento {
  CPF
  CNPJ
}

enum PorteAnimal {
  PEQUENO
  MEDIO
  GRANDE
}

enum StatusCanil {
  LIVRE
  OCUPADO
  MANUTENCAO
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum TipoItemCatalogo {
  PRODUTO
  SERVICO
  MENSALIDADE
}

enum FormaPagamento {
  DINHEIRO
  PIX_MANUAL
  CARTAO_MANUAL
  BOLETO
  PIX_MERCADOPAGO
  CARTAO_LINK
  // DEPRECADO: representava "item incluso de graça no plano". Esse conceito
  // foi removido (ver PlanoItem, também removido) — não é mais oferecido na
  // tela de Vendas. Mantido no enum só porque vendas antigas no banco usam
  // esse valor e remover um valor de enum no Postgres exige recriar o tipo;
  // não vale o risco pra um valor puramente histórico.
  MENSALISTA
  // Único jeito de "pagar como mensalista" hoje: acumula na fatura mensal em
  // vez de pagar na hora. Exibido na tela como "Mensalista" (ver
  // src/lib/cobranca-labels.ts) — o nome do enum ficou de quando também
  // existia o MENSALISTA acima; renomear o valor do enum tem o mesmo custo
  // de recriar o tipo, então a UI que traduz, não o banco.
  A_FATURAR
}

enum StatusVenda {
  CONCLUIDA
  CANCELADA
}

enum StatusAssinatura {
  ATIVA
  PAUSADA
  CANCELADA
}

enum TipoCobranca {
  BOLETO
  PIX
  CARTAO_LINK
}

enum StatusCobranca {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

enum StatusConta {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

// ---------- Plataforma (dados da própria SaaS, não de um petshop) ----------

// Um petshop-cliente que assina o SaaS. Cada Empresa usa o MESMO banco que
// todas as outras (isolamento por `empresaId`, não por banco físico) e tem
// suas próprias credenciais de Mercado Pago — nunca compartilhadas entre
// empresas. Envio de cobrança por WhatsApp é feito via link direto (wa.me),
// que não depende de nenhuma credencial própria da empresa (ver README).
model Empresa {
  id                        String        @id @default(cuid())
  nome                      String
  tipoDocumento             TipoDocumento?
  documento                 String?       // CPF ou CNPJ do petshop-cliente, conforme tipoDocumento
  emailResponsavel          String
  status                    StatusEmpresa @default(ATIVA)

  // Credencial própria do petshop (cobrança via Mercado Pago)
  mercadoPagoAccessTokenEnc String?

  // Módulos habilitados para esta empresa (liga/desliga telas inteiras, ex:
  // um petshop sem hotelzinho não precisa de Canil/Hospedagem). Controla o
  // teto de acesso: um usuário nunca vê um módulo que a própria empresa não
  // tem habilitado, mesmo que o campo dele (Usuario.modulosPermitidos) o
  // liste. Ver src/lib/modulos.ts para a lista canônica de chaves válidas.
  modulosHabilitados        String[]      @default(["animais", "canil", "produtos_servicos", "planos", "agenda", "vendas", "financeiro"])

  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  usuarios                  Usuario[]
  convites                  ConviteUsuario[]

  @@index([status])
}

// Login da plataforma. SUPER_ADMIN (a Fernanda) não pertence a nenhuma Empresa
// (empresaId nulo); EMPRESA_ADMIN/EMPRESA_ATENDENTE pertencem a uma Empresa.
model Usuario {
  id                String      @id @default(cuid())
  nome              String
  email             String      @unique
  senhaHash         String?     // nulo até o convite ser aceito e a senha definida
  role              RoleUsuario
  empresaId         String?
  empresa           Empresa?    @relation(fields: [empresaId], references: [id])
  ativo             Boolean     @default(true)
  createdAt         DateTime    @default(now())

  // Só tem efeito para EMPRESA_ATENDENTE (EMPRESA_ADMIN e SUPER_ADMIN sempre
  // veem tudo que a empresa habilitou). Lista vazia = sem restrição extra
  // (herda todos os módulos da empresa); lista não-vazia = restringe à
  // interseção com os módulos da empresa. Ver src/lib/modulos.ts.
  modulosPermitidos String[]    @default([])

  convites          ConviteUsuario[]
  vendasCriadas     Venda[]     @relation("VendaCriadoPor")

  @@index([empresaId])
}

// Token de convite para o usuário definir a própria senha pela primeira vez.
model ConviteUsuario {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId String?
  empresa   Empresa?  @relation(fields: [empresaId], references: [id])
  token     String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

// ---------- Dados operacionais de cada petshop (escopados por empresaId) ----------

model Cliente {
  id            String   @id @default(cuid())
  empresaId     String
  nome          String
  documento     String?  // CPF ou CNPJ
  telefone      String   // WhatsApp, formato E.164 ex: 5511999998888
  email         String?
  endereco      String? // texto livre, exibição/observação — NÃO é o que o Boleto usa (ver campos abaixo)
  // Endereço ESTRUTURADO, separado do campo livre acima de propósito: só a
  // API de boleto do Mercado Pago exige isso (zip_code/street_name/
  // street_number/neighborhood/city/federal_unit, todos obrigatórios —
  // confirmado via erro real em produção, depois de já ter corrigido
  // documento e nome/sobrenome separadamente). Deixar como campos à parte,
  // todos opcionais no cadastro geral, evita forçar TODO cliente a
  // preencher 6 campos de endereço só pra poder cadastrar — a validação
  // (exigir tudo preenchido) só dispara quando Boleto é de fato escolhido,
  // em três lugares: venda avulsa (vendas/actions.ts), criação de
  // assinatura (src/lib/assinatura.ts) e geração de fatura
  // (src/lib/faturamento.ts). Preenchidos no cadastro via CEP + busca
  // automática (ViaCEP) — ver ClienteForm.tsx.
  cep           String?
  logradouro    String?
  numero        String?
  complemento   String?
  bairro        String?
  cidade        String?
  uf            String?
  observacoes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  animais       Animal[]
  vendas        Venda[]
  assinaturas   Assinatura[]
  agendamentos  Agendamento[]
  contasReceber ContaReceber[]

  @@index([empresaId])
  @@index([empresaId, nome])
  @@index([empresaId, telefone])
}

model Animal {
  id             String       @id @default(cuid())
  empresaId      String
  nome           String
  clienteId      String
  cliente        Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  especie        String       // Cão, Gato, etc.
  raca           String?
  porte          PorteAnimal?
  dataNascimento DateTime?
  pesoKg         Decimal?     @db.Decimal(6, 2)
  observacoes    String?      // alergias, restrições, temperamento
  ativo          Boolean      @default(true)
  createdAt      DateTime     @default(now())

  agendamentos   Agendamento[]
  itensVenda     ItemVenda[]
  hospedagens    Hospedagem[]
  vendas         Venda[]

  @@index([empresaId])
  @@index([clienteId])
}

model Canil {
  id             String       @id @default(cuid())
  empresaId      String
  identificador  String       // ex: "Canil 01" — único DENTRO da empresa (duas empresas podem ter as duas um "Canil 01")
  tipoPorte      PorteAnimal?
  capacidade     Int          @default(1)
  status         StatusCanil  @default(LIVRE)
  observacoes    String?

  hospedagens    Hospedagem[]
  agendamentos   Agendamento[]

  @@unique([empresaId, identificador])
  @@index([empresaId])
}

model Hospedagem {
  id               String    @id @default(cuid())
  empresaId        String
  canilId          String
  canil            Canil     @relation(fields: [canilId], references: [id])
  animalId         String
  animal           Animal    @relation(fields: [animalId], references: [id])
  checkIn          DateTime
  checkOutPrevisto DateTime?
  checkOut         DateTime?
  valorDiaria      Decimal?  @db.Decimal(10, 2)
  observacoes      String?
  createdAt        DateTime  @default(now())

  @@index([empresaId])
  @@index([canilId])
  @@index([animalId])
}

// Catálogo único da empresa: produto, serviço OU mensalidade, diferenciados
// por `tipo`. Antes eram três models separados (Produto, Servico, Plano) —
// unificados porque, na prática, os três são "coisas que a empresa vende",
// e a separação em models diferentes forçava a tela de Vendas a ter dois
// seletores (produto vs. serviço) e deixava mensalidade fora do catálogo,
// numa área totalmente à parte (Planos). Ver README para o histórico da
// decisão.
//
// Campos que só fazem sentido pra um `tipo` ficam opcionais e simplesmente
// não são preenchidos pros outros (`estoque`/`sku` só PRODUTO,
// `duracaoMinutos` só SERVICO, `diaCobrancaPadrao` só MENSALIDADE) — one
// table, campos esparsos, mais simples que herança de tabela no Postgres
// pra esse volume de dados.
model ItemCatalogo {
  id                String           @id @default(cuid())
  empresaId         String
  tipo              TipoItemCatalogo
  nome              String
  categoria         String?
  descricao         String?
  // Preço avulso (PRODUTO/SERVICO) OU valor da mensalidade (MENSALIDADE).
  preco             Decimal          @db.Decimal(10, 2)
  estoque           Int?             // só PRODUTO
  sku               String?          // só PRODUTO, único DENTRO da empresa
  duracaoMinutos    Int?             // só SERVICO
  diaCobrancaPadrao Int?             // só MENSALIDADE — dia padrão de cobrança pra quem assina
  ativo             Boolean          @default(true)
  createdAt         DateTime         @default(now())

  itensVenda        ItemVenda[]
  assinaturas       Assinatura[]
  agendamentos      Agendamento[]

  @@unique([empresaId, sku])
  @@index([empresaId])
  @@index([empresaId, tipo])
}

// Assinatura de um cliente a uma mensalidade do catálogo (o que torna o
// cliente "mensalista"). Criada a partir do cadastro do cliente OU ao
// vender um item tipo MENSALIDADE no carrinho de Vendas — as duas telas
// chamam a mesma função (ver src/lib/assinatura.ts).
model Assinatura {
  id             String           @id @default(cuid())
  empresaId      String
  clienteId      String
  cliente        Cliente          @relation(fields: [clienteId], references: [id])
  itemCatalogoId String
  itemCatalogo   ItemCatalogo     @relation(fields: [itemCatalogoId], references: [id])
  valorMensal    Decimal          @db.Decimal(10, 2) // copiado do catálogo na criação, pode ser customizado
  diaCobranca    Int
  // Forma de cobrança PADRÃO desta assinatura — precisa estar guardada aqui
  // (não só escolhida na hora) porque a fatura mensal também é gerada
  // sozinha pelo cron, sem ninguém pra perguntar. Pode ser sobrescrita
  // pontualmente ao gerar uma fatura específica manualmente (ver
  // gerarFaturaMensal em src/lib/faturamento.ts) — isso NÃO altera este
  // campo, só vale pra aquela fatura. BOLETO exige Cliente.documento
  // (validado na criação da assinatura, ver src/lib/assinatura.ts).
  formaCobranca  TipoCobranca     @default(PIX)
  status         StatusAssinatura @default(ATIVA)
  dataInicio     DateTime         @default(now())
  dataFim        DateTime?
  createdAt      DateTime         @default(now())

  cobrancas      Cobranca[]
  vendas         Venda[]

  @@index([empresaId])
  @@index([clienteId])
  @@index([status])
}

model Venda {
  id              String         @id @default(cuid())
  empresaId       String
  numero          Int            @unique @default(autoincrement()) // sequência GLOBAL (não por empresa) — ver nota no README
  clienteId       String
  cliente         Cliente        @relation(fields: [clienteId], references: [id])
  animalId        String?
  animal          Animal?        @relation(fields: [animalId], references: [id])
  assinaturaId    String?        // preenchido quando debitado de uma mensalidade OU lançado na fatura (A_FATURAR)
  assinatura      Assinatura?    @relation(fields: [assinaturaId], references: [id])
  formaPagamento  FormaPagamento
  valorTotal      Decimal        @db.Decimal(10, 2)
  status          StatusVenda    @default(CONCLUIDA)
  observacoes     String?
  criadoPorId     String?
  criadoPor       Usuario?       @relation("VendaCriadoPor", fields: [criadoPorId], references: [id])
  createdAt       DateTime       @default(now())

  itens             ItemVenda[]
  cobranca          Cobranca?

  // Preenchido quando esta venda (formaPagamento = A_FATURAR) já foi
  // incluída numa fatura mensal consolidada — impede cobrar a mesma venda
  // avulsa duas vezes. Relação nomeada porque é diferente da relação 1:1
  // `cobranca` acima (uma Cobranca "de venda" vs. uma Cobranca "de fatura"
  // que agrupa várias vendas).
  faturaCobrancaId String?
  faturaCobranca    Cobranca?    @relation("VendaFaturada", fields: [faturaCobrancaId], references: [id])

  @@index([empresaId])
  @@index([clienteId])
  @@index([createdAt])
  @@index([faturaCobrancaId])
}

// Linha de item de uma Venda. NÃO tem empresaId próprio: só existe aninhada
// dentro de uma Venda (nunca é lida/criada/apagada de forma avulsa), então o
// isolamento por empresa vem do join com Venda.empresaId.
//
// Sempre referencia um ItemCatalogo — inclusive quando é uma MENSALIDADE
// (vender uma mensalidade no carrinho cria a Assinatura e registra a linha
// aqui só pra histórico/recibo; esse subtotal NÃO entra em Venda.valorTotal,
// ver src/app/(app)/vendas/actions.ts). Não precisa mais de um campo `tipo`
// próprio: dá pra saber PRODUTO/SERVICO/MENSALIDADE pelo `itemCatalogo.tipo`
// (era um enum redundante quando existiam produtoId/servicoId separados).
model ItemVenda {
  id             String       @id @default(cuid())
  vendaId        String
  venda          Venda        @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  itemCatalogoId String
  itemCatalogo   ItemCatalogo @relation(fields: [itemCatalogoId], references: [id])
  animalId       String?      // qual animal recebeu o serviço, se aplicável
  animal         Animal?      @relation(fields: [animalId], references: [id])
  quantidade     Int          @default(1)
  precoUnitario  Decimal      @db.Decimal(10, 2)
  subtotal       Decimal      @db.Decimal(10, 2)

  @@index([vendaId])
  @@index([itemCatalogoId])
}

// Cobrança gerada via Mercado Pago (boleto / pix / link de cartão),
// vinculada a uma Venda avulsa OU a uma mensalidade de Assinatura.
model Cobranca {
  id               String         @id @default(cuid())
  empresaId        String
  tipo             TipoCobranca
  status           StatusCobranca @default(PENDENTE)
  valor            Decimal        @db.Decimal(10, 2)
  vendaId          String?        @unique
  venda            Venda?         @relation(fields: [vendaId], references: [id])
  assinaturaId     String?
  assinatura       Assinatura?    @relation(fields: [assinaturaId], references: [id])
  referenciaMes    String?        // ex: "2026-08", usado para mensalidades
  mercadoPagoId    String?
  linkPagamento    String?
  qrCode           String?        // payload "copia e cola" do Pix
  qrCodeBase64     String?
  linhaDigitavel   String?        // boleto
  dataVencimento   DateTime
  dataPagamento    DateTime?
  // Marca só o clique em "Abrir no WhatsApp" (CobrancaPainel) — NÃO é
  // confirmação de entrega/leitura (não temos integração pra isso, de
  // propósito, ver README "Mercado Pago e WhatsApp"). Serve pra alimentar o
  // lembrete "fatura gerada mas ninguém marcou como enviada" no painel e na
  // lista de faturamento mensal.
  notificadoClienteEm DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Vendas avulsas (formaPagamento = A_FATURAR) consolidadas nesta cobrança,
  // quando ela é uma fatura mensal (assinaturaId setado, vendaId nulo).
  vendasFaturadas  Venda[]        @relation("VendaFaturada")

  @@index([empresaId])
  @@index([status])
  @@index([assinaturaId])
  // Garante no banco (não só na aplicação) que nunca existem duas faturas
  // consolidadas pra mesma assinatura no mesmo mês — proteção real contra
  // cobrança duplicada se o cron rodar mais de uma vez. NULLs não colidem
  // entre si no Postgres, então isso não afeta cobranças de venda avulsa
  // (assinaturaId/referenciaMes nulos nesse caso).
  @@unique([assinaturaId, referenciaMes])
}

model ContaPagar {
  id             String      @id @default(cuid())
  empresaId      String
  descricao      String
  fornecedor     String?
  categoria      String?
  valor          Decimal     @db.Decimal(10, 2)
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         StatusConta @default(PENDENTE)
  observacoes    String?
  createdAt      DateTime    @default(now())

  @@index([empresaId])
  @@index([status])
  @@index([dataVencimento])
}

// Recebíveis fora do fluxo padrão de Venda/Cobrança (ex: acordo avulso, reembolso).
// Cobranças de vendas/mensalidades já aparecem no financeiro através do modelo Cobranca.
model ContaReceber {
  id              String      @id @default(cuid())
  empresaId       String
  descricao       String
  clienteId       String?
  cliente         Cliente?    @relation(fields: [clienteId], references: [id])
  valor           Decimal     @db.Decimal(10, 2)
  dataVencimento  DateTime
  dataRecebimento DateTime?
  status          StatusConta @default(PENDENTE)
  observacoes     String?
  createdAt       DateTime    @default(now())

  @@index([empresaId])
  @@index([status])
  @@index([dataVencimento])
}

model Agendamento {
  id             String            @id @default(cuid())
  empresaId      String
  clienteId      String
  cliente        Cliente           @relation(fields: [clienteId], references: [id])
  animalId       String
  animal         Animal            @relation(fields: [animalId], references: [id])
  // Referencia um ItemCatalogo de tipo SERVICO — o schema não força isso
  // (Prisma não tem CHECK cross-column nativo aqui), a tela de agenda que só
  // lista itens desse tipo no seletor.
  itemCatalogoId String?
  itemCatalogo   ItemCatalogo?     @relation(fields: [itemCatalogoId], references: [id])
  canilId        String?
  canil          Canil?            @relation(fields: [canilId], references: [id])
  dataHoraInicio DateTime
  dataHoraFim    DateTime?
  status         StatusAgendamento @default(AGENDADO)
  observacoes    String?
  createdAt      DateTime          @default(now())

  @@index([empresaId])
  @@index([dataHoraInicio])
  @@index([status])
}
