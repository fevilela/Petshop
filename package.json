{
  "name": "petshop-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "prisma generate --schema=prisma/control/schema.prisma && prisma generate --schema=prisma/tenant/schema.prisma",
    "control:migrate": "prisma migrate dev --schema=prisma/control/schema.prisma",
    "control:deploy": "prisma migrate deploy --schema=prisma/control/schema.prisma",
    "control:studio": "prisma studio --schema=prisma/control/schema.prisma",
    "tenant:migrate": "prisma migrate dev --schema=prisma/tenant/schema.prisma",
    "tenant:deploy": "prisma migrate deploy --schema=prisma/tenant/schema.prisma",
    "tenant:studio": "prisma studio --schema=prisma/tenant/schema.prisma",
    "seed": "tsx prisma/tenant/seed.ts",
    "seed:control": "tsx prisma/control/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "bcryptjs": "2.4.3",
    "next": "14.2.35",
    "next-auth": "4.24.8",
    "prisma": "5.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  }
}
